# Satu-satunya file konfigurasi lingkungan adalah `.env` (tidak ada env.dev/env.prod).
# Salin berkas ini menjadi `.env` dan ganti nilainya, contoh:
#   SESSION_SECRET     -> openssl rand -base64 32
#   DATABASE_URL       -> postgresql://USER:PASSWORD@localhost:5432/duitku_tracker

# Dipakai autentikasi (Orang 1) untuk menandatangani cookie session (HS256).
SESSION_SECRET=your_random_32_byte_secret

# Dipakai lapisan data (Orang 2) untuk koneksi PostgreSQL (skema prisma/).
# Ganti dengan kredensial lokal lalu hapus tanda komentar:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/duitku_tracker